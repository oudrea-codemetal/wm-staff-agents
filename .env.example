# WarMatrix — set after deploying WarMatrix or using a shared instance
WM_API_URL=http://127.0.0.1:18000/v2
WM_V1_API_URL=http://127.0.0.1:18000/v1
WM_GAME_IDS=3
WM_BEARER_TOKEN=
# Or use Keycloak:
# WM_TOKEN_URL=http://127.0.0.1:8080/realms/warmatrix/protocol/openid-connect/token
# WM_USERNAME=
# WM_PASSWORD=

# LLM — any OpenAI-compatible endpoint (OpenAI, vLLM, etc.)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Jev doctrine checker
JEV_URL=http://100.111.138.48:8012

# Slack (optional — without this, messages go to stdout)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_RED_CHANNEL=#wargame-red
SLACK_BLUE_CHANNEL=#wargame-blue
